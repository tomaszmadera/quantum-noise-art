---
/**
 * Hero particle / orbit visual. Inline SVG generated at build time from a
 * fixed seed, so every build produces the same picture. Decorative only.
 */
import { dotPath, gauss, rng, rotate, type Point } from '../lib/noise';

interface Props {
  seed?: number;
  class?: string;
}

const { seed = 1729, class: className } = Astro.props;
const r = rng(seed);
const W = 820;
const H = 560;
const cx = 420;
const cy = 270;
const tilt = -14;

type Orbit = { rx: number; ry: number; rot: number; dashed: boolean; opacity: number };
const orbits: Orbit[] = Array.from({ length: 7 }, (_, i) => {
  const rx = 95 + i * 46 + r() * 18;
  return {
    rx,
    ry: rx * (0.27 + r() * 0.09),
    rot: tilt + (r() - 0.5) * 12,
    dashed: r() < 0.35,
    opacity: 0.1 + r() * 0.2,
  };
});

const groups: Record<string, Point[]> = { white: [], whiteBig: [], violet: [], blue: [], dust: [] };
const put = (p: Point) => {
  const c = r();
  if (c < 0.12) groups.whiteBig.push(p);
  else if (c < 0.62) groups.white.push(p);
  else if (c < 0.86) groups.violet.push(p);
  else groups.blue.push(p);
};

// Dots strewn along each orbit, thicker on one side for a sense of motion.
for (const o of orbits) {
  const n = Math.round(50 + o.rx * 0.22);
  const phase = r() * Math.PI * 2;
  for (let i = 0; i < n; i++) {
    const t = phase + Math.pow(r(), 1.6) * Math.PI * 2;
    const p: Point = [cx + o.rx * Math.cos(t) + gauss(r) * 3.5, cy + o.ry * Math.sin(t) + gauss(r) * 2.5];
    put(rotate(p, cx, cy, o.rot));
  }
}
// Dense core.
for (let i = 0; i < 300; i++) {
  const a = r() * Math.PI * 2;
  const d = Math.abs(gauss(r)) * 34;
  put(rotate([cx + Math.cos(a) * d * 1.6, cy + Math.sin(a) * d * 0.7], cx, cy, tilt));
}
// Background dust.
for (let i = 0; i < 160; i++) groups.dust.push([r() * W, r() * H]);

// A few marker squares on the orbits.
const markers = [1, 3, 5].map((i) => {
  const o = orbits[i];
  const t = r() * Math.PI * 2;
  return rotate([cx + o.rx * Math.cos(t), cy + o.ry * Math.sin(t)], cx, cy, o.rot);
});
const gid = `qn-core-${seed}`;
---

<svg
  aria-hidden="true"
  focusable="false"
  class:list={['qn-orbit', className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <radialGradient id={gid}>
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"></stop>
      <stop offset="0.25" stop-color="#c4b5fd" stop-opacity="0.18"></stop>
      <stop offset="1" stop-color="#7c3aed" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <ellipse cx={cx} cy={cy} rx="210" ry="120" fill={`url(#${gid})`} transform={`rotate(${tilt} ${cx} ${cy})`}></ellipse>
  <line x1={cx - 70} y1="10" x2={cx - 70} y2={H - 30} stroke="#e4e4e7" stroke-opacity="0.22" stroke-width="0.6"></line>
  <line x1="40" y1={cy + 40} x2={W - 20} y2={cy - 90} stroke="#e4e4e7" stroke-opacity="0.08" stroke-width="0.6"></line>
  {
    orbits.map((o) => (
      <ellipse
        cx={cx}
        cy={cy}
        rx={o.rx.toFixed(1)}
        ry={o.ry.toFixed(1)}
        fill="none"
        stroke="#e4e4e7"
        stroke-opacity={o.opacity.toFixed(2)}
        stroke-width="0.7"
        stroke-dasharray={o.dashed ? '2 7' : undefined}
        transform={`rotate(${o.rot.toFixed(1)} ${cx} ${cy})`}
      />
    ))
  }
  <path d={dotPath(groups.dust)} stroke="#a1a1aa" stroke-opacity="0.35" stroke-width="1" stroke-linecap="round"></path>
  <path d={dotPath(groups.violet)} stroke="#a78bfa" stroke-opacity="0.85" stroke-width="1.6" stroke-linecap="round"></path>
  <path d={dotPath(groups.blue)} stroke="#93c5fd" stroke-opacity="0.8" stroke-width="1.5" stroke-linecap="round"></path>
  <path d={dotPath(groups.white)} stroke="#fafafa" stroke-opacity="0.75" stroke-width="1.3" stroke-linecap="round"></path>
  <path d={dotPath(groups.whiteBig)} stroke="#ffffff" stroke-width="2.6" stroke-linecap="round"></path>
  {
    markers.map(([x, y]) => (
      <rect x={(x - 3).toFixed(1)} y={(y - 3).toFixed(1)} width="6" height="6" fill="none" stroke="#fafafa" stroke-opacity="0.7" stroke-width="0.8" />
    ))
  }
  <g stroke="#fafafa" stroke-opacity="0.8" stroke-width="0.8">
    <line x1={cx - 9} y1={cy} x2={cx + 9} y2={cy}></line>
    <line x1={cx} y1={cy - 9} x2={cx} y2={cy + 9}></line>
  </g>
</svg>
